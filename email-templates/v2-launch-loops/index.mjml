<mjml>
  <mj-head>
    <mj-title>Helthy v2 is here.</mj-title>
    <mj-preview>Android is live, AI got smarter, and Premium is now $2.99/mo. Here's everything new.</mj-preview>
    <mj-font name="DM Sans" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&amp;display=swap" />
    <mj-font name="Unbounded" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500;600&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif" />
      <mj-text color="#FFFFFF" font-size="16px" font-weight="400" line-height="1.65" padding="0" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style>
      a { text-decoration: none; }
      .heading-serif { font-family: 'Lyon Display', Georgia, 'Times New Roman', serif !important; }
      .numeric-display { font-family: 'Unbounded', 'DM Sans', Arial, sans-serif !important; }
      /* Background gradient on the body wrapper (supported clients) */
      .bg-grad { background: #0F0F0F; background: linear-gradient(180deg, #0F0F0F 0%, #1A2024 35%, #1F282E 60%, #0F0F0F 100%) !important; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#0F0F0F" width="560px" css-class="bg-grad">

    <!-- Top spacer -->
    <mj-section padding="40px 0 0">
      <mj-column><mj-text padding="0"> </mj-text></mj-column>
    </mj-section>

    <!-- HEADER: Logo -->
    <mj-section background-color="#111111" border-radius="16px 16px 0 0"
      border="1px solid #1F1F1F" padding="28px 40px">
      <mj-column>
        <mj-image
          src="img/logo-long-green.png"
          alt="Helthy" width="108px" height="21px" align="center" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Lemon accent line -->
    <mj-section background-color="#151515" padding="0">
      <mj-column padding="0">
        <mj-divider border-color="#CDFF50" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Version badge + headline + intro -->
    <mj-section background-color="#151515" padding="40px 40px 0">
      <mj-column>

        <!-- Version badge (kept — it's the one meaningful pill) -->
        <mj-text padding="0 0 24px">
          <span style="display:inline-block;font-family:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:11px;font-weight:500;letter-spacing:0.22em;text-transform:uppercase;color:#CDFF50;background-color:#192208;border:1px solid #3A5010;border-radius:999px;padding:5px 14px;">
            Version 2.0
          </span>
        </mj-text>

        <!-- Headline (serif, light) -->
        <mj-text css-class="heading-serif" padding="0 0 18px"
          font-family="'Lyon Display', Georgia, 'Times New Roman', serif"
          font-size="38px" font-weight="300"
          line-height="1.05" letter-spacing="-0.035em" color="#FFFFFF">
          We rebuilt Helthy.<br />Here's what's new.
        </mj-text>

        <!-- Intro -->
        <mj-text padding="0 0 32px" font-size="16px" font-weight="400" line-height="1.65"
          color="rgba(255,255,255,0.65)">
          Hey, {firstName} — v2 is live on iOS and Android. This is the biggest update since launch: smarter AI, deeper insights, and a lot of things that should've been there from day one.
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- Feature cards (raw HTML for full 3D inset/shadow control) -->
    <mj-section background-color="#151515" padding="0 40px 14px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="background:linear-gradient(180deg,#212121 0%,#161616 100%);border:1px solid #2A2A2A;border-radius:16px;padding:24px 26px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.08), 0 8px 24px rgba(0,0,0,0.35);">
                <p style="margin:0 0 10px;font-family:'Unbounded','DM Sans',Arial,sans-serif;font-size:11px;font-weight:500;letter-spacing:0.05em;color:#CDFF50;">01</p>
                <p style="margin:0 0 8px;font-family:'Lyon Display',Georgia,'Times New Roman',serif;font-size:20px;font-weight:300;line-height:1.2;letter-spacing:-0.02em;color:#FFFFFF;">AI got a lot smarter.</p>
                <p style="margin:0;font-family:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:15px;font-weight:400;line-height:1.6;color:rgba(255,255,255,0.72);">
                  Body fat estimates from progress photos. Plateau detection with a fix plan. Goal ETA predictor. Weekly physique report. Strength progression forecast. Your coach now sees four weeks ahead.
                </p>
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <mj-section background-color="#151515" padding="0 40px 14px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="background:linear-gradient(180deg,#212121 0%,#161616 100%);border:1px solid #2A2A2A;border-radius:16px;padding:24px 26px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.08), 0 8px 24px rgba(0,0,0,0.35);">
                <p style="margin:0 0 10px;font-family:'Unbounded','DM Sans',Arial,sans-serif;font-size:11px;font-weight:500;letter-spacing:0.05em;color:#CDFF50;">02</p>
                <p style="margin:0 0 8px;font-family:'Lyon Display',Georgia,'Times New Roman',serif;font-size:20px;font-weight:300;line-height:1.2;letter-spacing:-0.02em;color:#FFFFFF;">Insights that actually mean something.</p>
                <p style="margin:0;font-family:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:15px;font-weight:400;line-height:1.6;color:rgba(255,255,255,0.72);">
                  Momentum Ring, signal cards, and a weekly narrative written in plain English. Your coach summarises your whole week — what worked, what didn't, and what to do next.
                </p>
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <mj-section background-color="#151515" padding="0 40px 14px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="background:linear-gradient(180deg,#212121 0%,#161616 100%);border:1px solid #2A2A2A;border-radius:16px;padding:24px 26px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.08), 0 8px 24px rgba(0,0,0,0.35);">
                <p style="margin:0 0 10px;font-family:'Unbounded','DM Sans',Arial,sans-serif;font-size:11px;font-weight:500;letter-spacing:0.05em;color:#CDFF50;">03</p>
                <p style="margin:0 0 8px;font-family:'Lyon Display',Georgia,'Times New Roman',serif;font-size:20px;font-weight:300;line-height:1.2;letter-spacing:-0.02em;color:#FFFFFF;">Logging got faster.</p>
                <p style="margin:0;font-family:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:15px;font-weight:400;line-height:1.6;color:rgba(255,255,255,0.72);">
                  Nutrition label scanner, quick meal entry, photo logging, and food suggestions for common meals. Swipe to delete. Import from MFP, MacroFactor, Hevy, Strong, and more.
                </p>
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <mj-section background-color="#151515" padding="0 40px 32px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="background:linear-gradient(180deg,#212121 0%,#161616 100%);border:1px solid #2A2A2A;border-radius:16px;padding:24px 26px;box-shadow:inset 0 1px 0 rgba(255,255,255,0.08), 0 8px 24px rgba(0,0,0,0.35);">
                <p style="margin:0 0 10px;font-family:'Unbounded','DM Sans',Arial,sans-serif;font-size:11px;font-weight:500;letter-spacing:0.05em;color:#CDFF50;">04</p>
                <p style="margin:0 0 8px;font-family:'Lyon Display',Georgia,'Times New Roman',serif;font-size:20px;font-weight:300;line-height:1.2;letter-spacing:-0.02em;color:#FFFFFF;">Android is here + 6 languages.</p>
                <p style="margin:0;font-family:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:15px;font-weight:400;line-height:1.6;color:rgba(255,255,255,0.72);">
                  Helthy is now on Google Play. Full support for Arabic, German, Spanish, French, Hindi, and Chinese. Share the app with anyone, anywhere.
                </p>
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <!-- Premium card (raw HTML for 3D shadows + inline CTA) -->
    <mj-section background-color="#151515" padding="0 40px 32px">
      <mj-column>
        <mj-raw>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="background:linear-gradient(160deg,#1F2A0D 0%,#151A08 60%,#0F1106 100%);border:1px solid rgba(205,255,80,0.28);border-radius:18px;padding:28px 26px;box-shadow:inset 0 1px 0 rgba(205,255,80,0.18), 0 12px 40px rgba(205,255,80,0.1), 0 8px 24px rgba(0,0,0,0.4);">
                <p style="margin:0 0 6px;font-family:'Lyon Display',Georgia,'Times New Roman',serif;font-size:15px;font-weight:300;letter-spacing:-0.01em;color:#CDFF50;">Introducing Premium</p>
                <p style="margin:0 0 14px;font-family:'Unbounded','DM Sans',Arial,sans-serif;font-size:34px;font-weight:500;letter-spacing:-0.02em;line-height:1.1;color:#FFFFFF;">
                  $2.99<span style="font-family:'Unbounded','DM Sans',Arial,sans-serif;font-size:20px;font-weight:400;color:rgba(255,255,255,0.5);letter-spacing:0;">/mo</span>
                </p>
                <p style="margin:0 0 22px;font-family:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:14px;font-weight:400;line-height:1.65;color:rgba(255,255,255,0.65);">
                  Everything. Unlimited AI coach, photo logging, body fat estimates, full analytics, generated routines, all-time history, and every feature we ship going forward. Or go yearly for $19.99 &mdash; that's $1.67/mo.
                </p>
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center" style="background-color:#CDFF50;border-radius:999px;box-shadow:inset 0 2px 1px 0 rgba(255,255,255,0.5), inset 0 0.6px 0.6px -1.25px rgba(255,255,255,0.72), inset 0 2.29px 2.29px -2.5px rgba(255,255,255,0.635), inset 0 10px 10px -3.75px rgba(255,255,255,0.25), 0 20px 60px rgba(205,255,80,0.25);">
                      <a href="https://apps.apple.com/us/app/helthy-track-food-workouts/id6751759974" style="display:inline-block;padding:14px 32px;font-family:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:15px;font-weight:500;color:#0B0B0B;text-decoration:none;letter-spacing:-0.005em;white-space:nowrap;">Unlock Premium &rarr;</a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <!-- Already have it nudge -->
    <mj-section background-color="#151515" padding="0 40px 14px">
      <mj-column>
        <mj-text padding="0" font-size="13px" font-weight="400" color="rgba(255,255,255,0.45)">
          Already have it? Just update the app to get v2.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- App Store + Google Play (site btn-secondary) -->
    <mj-section background-color="#151515" padding="0 40px 40px">
      <mj-column>
        <mj-button
          href="https://apps.apple.com/us/app/helthy-track-food-workouts/id6751759974"
          background-color="rgba(255,255,255,0.06)" color="#FFFFFF"
          border="1px solid rgba(255,255,255,0.12)" border-radius="999px"
          font-size="15px" font-weight="500"
          font-family="'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif"
          inner-padding="14px 28px" padding="0 8px 0 0" align="left">
          App Store
        </mj-button>
      </mj-column>
      <mj-column>
        <mj-button
          href="https://play.google.com/store/apps/details?id=com.helthy.app"
          background-color="rgba(255,255,255,0.06)" color="#FFFFFF"
          border="1px solid rgba(255,255,255,0.12)" border-radius="999px"
          font-size="15px" font-weight="500"
          font-family="'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif"
          inner-padding="14px 28px" padding="0" align="left">
          Google Play
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Divider -->
    <mj-section background-color="#151515" padding="0 40px">
      <mj-column>
        <mj-divider border-color="#2A2A2A" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Signature -->
    <mj-section background-color="#151515" padding="28px 40px 32px">
      <mj-column>
        <mj-text padding="0" font-size="15px" font-weight="400" line-height="1.65"
          color="rgba(255,255,255,0.55)">
          – Chibu &amp; Ebuka<br />
          <span style="font-size:13px;">P.S. Reply directly with feedback — we read every message.</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Divider -->
    <mj-section background-color="#151515" padding="0 40px">
      <mj-column>
        <mj-divider border-color="#2A2A2A" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- FOOTER -->
    <mj-section background-color="#111111" border-radius="0 0 16px 16px"
      border="1px solid #1F1F1F" padding="24px 40px">
      <mj-column>
        <mj-text align="center" font-size="12px" font-weight="400" line-height="1.5"
          color="rgba(255,255,255,0.3)" padding="0 0 10px">
          You're receiving this because you signed up for Helthy updates.<br />
          Helthy App · 115th Street, Cleveland, Ohio
        </mj-text>
        <mj-text align="center" font-size="12px" font-weight="400" padding="0">
          <a href="{unsubscribe_link}"
            style="color:rgba(255,255,255,0.3);text-decoration:underline;">Unsubscribe</a>
          &nbsp;·&nbsp;
          <a href="https://helthy.app/privacy"
            style="color:rgba(255,255,255,0.3);text-decoration:underline;">Privacy Policy</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Bottom spacer -->
    <mj-section padding="40px 0 0">
      <mj-column><mj-text padding="0"> </mj-text></mj-column>
    </mj-section>

  </mj-body>
</mjml>
