<mjml>
  <mj-head>
    <mj-title>Helthy v2 is here.</mj-title>
    <mj-preview>Android is live, AI got smarter, and Premium is now $2.99/mo. Here's everything new.</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text color="#FFFFFF" font-size="16px" line-height="1.65" padding="0" />
      <mj-section padding="0" background-color="#151515" />
    </mj-attributes>
    <mj-style>
      a { text-decoration: none; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#0F0F0F" width="560px">

    <!-- Top spacer -->
    <mj-section background-color="#0F0F0F" padding="40px 0 0">
      <mj-column><mj-text padding="0"> </mj-text></mj-column>
    </mj-section>

    <!-- HEADER: Logo -->
    <mj-section background-color="#111111" border-radius="16px 16px 0 0"
      border="1px solid #1F1F1F" padding="28px 40px">
      <mj-column>
        <mj-image
          src="https://helthy.app/logos/logo-long-white.png"
          alt="Helthy" width="108px" align="center" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Lemon accent line -->
    <mj-section background-color="#151515" padding="0">
      <mj-column padding="0">
        <mj-divider border-color="#CDFF50" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Version badge + headline + intro -->
    <mj-section padding="40px 40px 0">
      <mj-column>

        <!-- Version badge -->
        <mj-text padding="0 0 20px">
          <span style="display:inline-block;font-size:11px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:#CDFF50;background-color:#192208;border:1px solid #3A5010;border-radius:999px;padding:5px 14px;">
            Version 2.0
          </span>
        </mj-text>

        <!-- Headline -->
        <mj-text padding="0 0 16px" font-size="30px" font-weight="700"
          line-height="1.15" letter-spacing="-0.03em" color="#FFFFFF">
          We rebuilt Helthy.<br />Here's what's new.
        </mj-text>

        <!-- Intro -->
        <mj-text padding="0 0 32px" font-size="16px" line-height="1.65"
          color="rgba(255,255,255,0.65)">
          Hey, {firstName} — v2 is live on iOS and Android. This is the biggest update since launch: smarter AI, deeper insights, and a lot of things that should've been there from day one.
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- Feature 1: AI (lemon accent card) -->
    <mj-section padding="0 40px 14px">
      <mj-column background-color="#192208" border="1px solid #3A5010"
        border-radius="14px" padding="20px 24px">
        <mj-text padding="0 0 6px" font-size="11px" font-weight="600"
          letter-spacing="0.15em" color="#CDFF50">
          AI GOT A LOT SMARTER
        </mj-text>
        <mj-text padding="0" font-size="15px" line-height="1.6"
          color="rgba(255,255,255,0.8)">
          Body fat estimates from progress photos. Plateau detection with a fix plan. Goal ETA predictor. Weekly physique report. Strength progression forecast. Your coach now sees four weeks ahead.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Feature 2: Insights -->
    <mj-section padding="0 40px 14px">
      <mj-column background-color="#1E1E1E" border="1px solid #2A2A2A"
        border-radius="14px" padding="20px 24px">
        <mj-text padding="0 0 6px" font-size="11px" font-weight="600"
          letter-spacing="0.15em" color="rgba(255,255,255,0.35)">
          INSIGHTS THAT ACTUALLY MEAN SOMETHING
        </mj-text>
        <mj-text padding="0" font-size="15px" line-height="1.6"
          color="rgba(255,255,255,0.8)">
          Momentum Ring, signal cards, and a weekly narrative written in plain English. Your coach summarises your whole week — what worked, what didn't, and what to do next.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Feature 3: Logging -->
    <mj-section padding="0 40px 14px">
      <mj-column background-color="#1E1E1E" border="1px solid #2A2A2A"
        border-radius="14px" padding="20px 24px">
        <mj-text padding="0 0 6px" font-size="11px" font-weight="600"
          letter-spacing="0.15em" color="rgba(255,255,255,0.35)">
          LOGGING GOT FASTER
        </mj-text>
        <mj-text padding="0" font-size="15px" line-height="1.6"
          color="rgba(255,255,255,0.8)">
          Nutrition label scanner, quick meal entry, photo logging, and food suggestions for common meals. Swipe to delete. Import from MFP, MacroFactor, Hevy, Strong, and more.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Feature 4: Android -->
    <mj-section padding="0 40px 32px">
      <mj-column background-color="#1E1E1E" border="1px solid #2A2A2A"
        border-radius="14px" padding="20px 24px">
        <mj-text padding="0 0 6px" font-size="11px" font-weight="600"
          letter-spacing="0.15em" color="rgba(255,255,255,0.35)">
          ANDROID IS HERE + 6 LANGUAGES
        </mj-text>
        <mj-text padding="0" font-size="15px" line-height="1.6"
          color="rgba(255,255,255,0.8)">
          Helthy is now on Google Play. Full support for Arabic, German, Spanish, French, Hindi, and Chinese. Share the app with anyone, anywhere.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Premium card -->
    <mj-section padding="0 40px 32px">
      <mj-column background-color="#192208" border="1px solid #3A5010"
        border-radius="14px" padding="24px">
        <mj-text padding="0 0 8px" font-size="11px" font-weight="600"
          letter-spacing="0.15em" color="#CDFF50">
          INTRODUCING PREMIUM
        </mj-text>
        <mj-text padding="0 0 14px" font-size="22px" font-weight="700"
          line-height="1.2" color="#FFFFFF">
          Everything. $2.99/mo.
        </mj-text>
        <mj-text padding="0 0 24px" font-size="14px" line-height="1.65"
          color="rgba(255,255,255,0.65)">
          Unlimited AI coach, photo logging, body fat estimates, full analytics, generated routines, all-time history, and every feature we ship going forward. Or go yearly for $19.99 — that's $1.67/mo.
        </mj-text>
        <mj-button
          href="https://apps.apple.com/us/app/helthy-track-food-workouts/id6751759974"
          background-color="#CDFF50" color="#0B0B0B"
          border-radius="999px" font-size="14px" font-weight="600"
          inner-padding="13px 28px" padding="0" align="left">
          Unlock Premium →
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Already have it nudge -->
    <mj-section padding="0 40px 12px">
      <mj-column>
        <mj-text padding="0" font-size="13px" color="rgba(255,255,255,0.35)">
          Already have it? Just update the app to get v2.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- App Store + Google Play buttons -->
    <mj-section padding="0 40px 40px">
      <mj-column>
        <mj-button
          href="https://apps.apple.com/us/app/helthy-track-food-workouts/id6751759974"
          background-color="#262626" color="#FFFFFF"
          border="1px solid #3A3A3A" border-radius="999px"
          font-size="14px" font-weight="500"
          inner-padding="12px 24px" padding="0 8px 0 0" align="left">
          App Store
        </mj-button>
      </mj-column>
      <mj-column>
        <mj-button
          href="https://play.google.com/store/apps/details?id=com.helthy.app"
          background-color="#262626" color="#FFFFFF"
          border="1px solid #3A3A3A" border-radius="999px"
          font-size="14px" font-weight="500"
          inner-padding="12px 24px" padding="0" align="left">
          Google Play
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Divider -->
    <mj-section padding="0 40px">
      <mj-column>
        <mj-divider border-color="#2A2A2A" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Signature -->
    <mj-section padding="28px 40px 32px">
      <mj-column>
        <mj-text padding="0" font-size="15px" line-height="1.65"
          color="rgba(255,255,255,0.45)">
          – Chibu &amp; Ebuka<br />
          <span style="font-size:13px;">P.S. Reply directly with feedback — we read every message.</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Divider -->
    <mj-section padding="0 40px">
      <mj-column>
        <mj-divider border-color="#2A2A2A" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- FOOTER -->
    <mj-section background-color="#111111" border-radius="0 0 16px 16px"
      border="1px solid #1F1F1F" padding="24px 40px">
      <mj-column>
        <mj-text align="center" font-size="12px" line-height="1.5"
          color="rgba(255,255,255,0.25)" padding="0 0 10px">
          You're receiving this because you signed up for Helthy updates.<br />
          Helthy App · 115th Street, Cleveland, Ohio
        </mj-text>
        <mj-text align="center" font-size="12px" padding="0">
          <a href="{unsubscribe_link}"
            style="color:rgba(255,255,255,0.25);text-decoration:underline;">Unsubscribe</a>
          &nbsp;·&nbsp;
          <a href="https://helthy.app/privacy"
            style="color:rgba(255,255,255,0.25);text-decoration:underline;">Privacy Policy</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Bottom spacer -->
    <mj-section background-color="#0F0F0F" padding="40px 0 0">
      <mj-column><mj-text padding="0"> </mj-text></mj-column>
    </mj-section>

  </mj-body>
</mjml>
