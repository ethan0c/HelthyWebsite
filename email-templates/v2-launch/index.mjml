<mjml>
  <mj-head>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
    <mj-title>Helthy v2 is here.</mj-title>
    <mj-preview>Android is live, AI got smarter, and Premium is now $2.99/mo. Here's everything new.</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif" />
      <mj-text color="#FFFFFF" font-size="15px" font-weight="400" line-height="1.6" padding="0" />
      <mj-section padding="0" />
      <mj-image padding="0" border="0" />
    </mj-attributes>
    <mj-style>
      a { text-decoration: none; }
      .bg-grad { background: #0F0F0F; background: linear-gradient(180deg, #0F0F0F 0%, #1A2024 35%, #1F282E 65%, #0F0F0F 100%) !important; }
      
      
      :root {
        color-scheme: light dark;
        supported-color-schemes: light dark;
      }
      
      /* Apple Mail / iOS Mail / General dark mode override */
      @media (prefers-color-scheme: dark) {
        body { background-color: #0F0F0F !important; }
        .bg-grad, .bg-grad > table, .bg-grad td { background-color: #0F0F0F !important; }
        .inner-card, .inner-card > table, .inner-card td { background-color: #151515 !important; }
        .footer-bg, .footer-bg > table, .footer-bg td { background-color: #111111 !important; }
        .sig-text, .sig-text div { color: rgba(255,255,255,0.55) !important; }
        .sig-ps { color: #777777 !important; }
        .footer-text, .footer-text div { color: rgba(255,255,255,0.3) !important; }
        a.footer-link, .footer-link { color: rgba(255,255,255,0.3) !important; }
      }
      
      /* Gmail iOS/Android specific override (u+ selector) */
      u + .body .bg-grad { background-color: #0F0F0F !important; }
      u + .body .bg-grad > table { background-color: #0F0F0F !important; }
      u + .body .bg-grad td { background-color: #0F0F0F !important; }
      u + .body .inner-card { background-color: #151515 !important; }
      u + .body .inner-card > table { background-color: #151515 !important; }
      u + .body .inner-card td { background-color: #151515 !important; }
      u + .body .footer-bg { background-color: #111111 !important; }
      u + .body .footer-bg > table { background-color: #111111 !important; }
      u + .body .footer-bg td { background-color: #111111 !important; }

      /* Gmail dark-mode guard ([data-ogsc] = Gmail forced dark mode) */
      [data-ogsc] body { background-color: #0F0F0F !important; }
      [data-ogsc] .bg-grad { background-color: #0F0F0F !important; }
      [data-ogsc] .bg-grad > table { background-color: #0F0F0F !important; }
      [data-ogsc] .bg-grad td { background-color: #0F0F0F !important; }
      [data-ogsc] .inner-card { background-color: #151515 !important; }
      [data-ogsc] .inner-card > table { background-color: #151515 !important; }
      [data-ogsc] .inner-card td { background-color: #151515 !important; }
      [data-ogsc] .footer-bg { background-color: #111111 !important; }
      [data-ogsc] .footer-bg > table { background-color: #111111 !important; }
      [data-ogsc] .footer-bg td { background-color: #111111 !important; }
      [data-ogsc] .sig-text, [data-ogsc] .sig-text div { color: rgba(255,255,255,0.55) !important; }
      [data-ogsc] .sig-ps { color: #777777 !important; }
      [data-ogsc] .footer-text, [data-ogsc] .footer-text div { color: rgba(255,255,255,0.3) !important; }
      [data-ogsc] a.footer-link { color: rgba(255,255,255,0.3) !important; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#0F0F0F" width="560px" css-class="bg-grad">

    <!-- Top spacer -->
    <mj-section padding="32px 0 0"><mj-column><mj-text padding="0"> </mj-text></mj-column></mj-section>

    <!-- FULL EMAIL VISUAL with transparent clickable overlays for buttons -->
    <mj-section padding="0" background-color="#151515" css-class="inner-card">
      <mj-column padding="0">
        <mj-raw>
          <div style="position:relative;display:block;font-size:0;line-height:0;">
            <img src="img/full-email.png"
              alt="We rebuilt Helthy. Here's what's new. v2 is live on iOS and Android. AI got smarter, deeper insights, faster logging, Android launch, and Premium at $2.99/mo."
              width="560" height="1577"
              style="display:block;width:100%;max-width:560px;height:auto;border:0;" />
            <a href="https://apps.apple.com/us/app/helthy-track-food-workouts/id6751759974"
              style="position:absolute;display:block;top:82.4%;left:4.5%;width:91%;height:7.9%;text-indent:-9999px;background:transparent;"
              aria-label="Unlock Premium">Unlock Premium</a>
            <a href="https://apps.apple.com/us/app/helthy-track-food-workouts/id6751759974"
              style="position:absolute;display:block;top:92.6%;left:20.5%;width:29.3%;height:5.7%;text-indent:-9999px;background:transparent;"
              aria-label="Download on the App Store">App Store</a>
            <a href="https://play.google.com/store/apps/details?id=com.helthy.app"
              style="position:absolute;display:block;top:92.6%;left:50%;width:29.3%;height:5.7%;text-indent:-9999px;background:transparent;"
              aria-label="Get it on Google Play">Google Play</a>
          </div>
        </mj-raw>
      </mj-column>
    </mj-section>

    <!-- Divider -->
    <mj-section background-color="#151515" css-class="inner-card" padding="0 40px">
      <mj-column padding="0">
        <mj-divider border-color="#2A2A2A" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Signature -->
    <mj-section background-color="#151515" css-class="inner-card" padding="24px 40px 28px">
      <mj-column padding="0">
        <mj-text padding="0" font-size="15px" font-weight="400" line-height="1.6"
          color="rgba(255,255,255,0.55)" css-class="sig-text">
          – Chibu &amp; Ebuka<br />
          <span class="sig-ps" style="font-size:13px;">P.S. Reply directly with feedback — we read every message.</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- FOOTER -->
    <mj-section background-color="#111111" css-class="footer-bg" padding="20px 40px 24px">
      <mj-column padding="0">
        <mj-text align="center" font-size="12px" font-weight="400" line-height="1.5"
          color="rgba(255,255,255,0.3)" padding="0 0 8px" css-class="footer-text">
          You're receiving this because you signed up for Helthy updates.<br />
          Helthy App &middot; 115th Street, Cleveland, Ohio
        </mj-text>
        <mj-text align="center" font-size="12px" font-weight="400" padding="0" css-class="footer-text">
          <a href="{unsubscribe_link}" class="footer-link" style="color:rgba(255,255,255,0.3);text-decoration:underline;">Unsubscribe</a>
          &nbsp;&middot;&nbsp;
          <a href="https://helthy.app/privacy" class="footer-link" style="color:rgba(255,255,255,0.3);text-decoration:underline;">Privacy Policy</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Bottom spacer -->
    <mj-section padding="40px 0 0"><mj-column><mj-text padding="0"> </mj-text></mj-column></mj-section>

  </mj-body>
</mjml>
