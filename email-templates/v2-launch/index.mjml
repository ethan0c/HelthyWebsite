<mjml>
  <mj-head>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
    <mj-title>Helthy v2 is here.</mj-title>
    <mj-preview>Android is live, AI got smarter, and Premium is now $2.99/mo. Here's everything new.</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif" />
      <mj-text color="#FFFFFF" font-size="15px" font-weight="400" line-height="1.6" padding="0" />
      <mj-section padding="0" />
      <mj-image padding="0" border="0" />
    </mj-attributes>
    <mj-style>
      a { text-decoration: none; }
      .bg-grad { background: #0F0F0F; background: linear-gradient(180deg, #0F0F0F 0%, #1A2024 35%, #1F282E 65%, #0F0F0F 100%) !important; }
      .mobile-only { display: none; max-height: 0; overflow: hidden; }
      @media only screen and (max-width: 600px) {
        .desktop-only { display: none !important; max-height: 0 !important; overflow: hidden !important; }
        .mobile-only { display: block !important; max-height: none !important; overflow: visible !important; }
      }
      
      
      :root {
        color-scheme: light dark;
        supported-color-schemes: light dark;
      }
      
      /* Apple Mail / iOS Mail / General dark mode override */
      @media (prefers-color-scheme: dark) {
        body { background-color: #0F0F0F !important; }
        .bg-grad, .bg-grad > table, .bg-grad td { background-color: #0F0F0F !important; }
        .inner-card, .inner-card > table, .inner-card td { background-color: #151515 !important; }
        .footer-bg, .footer-bg > table, .footer-bg td { background-color: #111111 !important; }
        .sig-text, .sig-text div { color: rgba(255,255,255,0.55) !important; }
        .sig-ps { color: #777777 !important; }
        .footer-text, .footer-text div { color: rgba(255,255,255,0.3) !important; }
        a.footer-link, .footer-link { color: rgba(255,255,255,0.3) !important; }
      }
      
      /* Gmail iOS/Android specific override (u+ selector) */
      u + .body .bg-grad { background-color: #0F0F0F !important; }
      u + .body .bg-grad > table { background-color: #0F0F0F !important; }
      u + .body .bg-grad td { background-color: #0F0F0F !important; }
      u + .body .inner-card { background-color: #151515 !important; }
      u + .body .inner-card > table { background-color: #151515 !important; }
      u + .body .inner-card td { background-color: #151515 !important; }
      u + .body .footer-bg { background-color: #111111 !important; }
      u + .body .footer-bg > table { background-color: #111111 !important; }
      u + .body .footer-bg td { background-color: #111111 !important; }

      /* Gmail dark-mode guard ([data-ogsc] = Gmail forced dark mode) */
      [data-ogsc] body { background-color: #0F0F0F !important; }
      [data-ogsc] .bg-grad { background-color: #0F0F0F !important; }
      [data-ogsc] .bg-grad > table { background-color: #0F0F0F !important; }
      [data-ogsc] .bg-grad td { background-color: #0F0F0F !important; }
      [data-ogsc] .inner-card { background-color: #151515 !important; }
      [data-ogsc] .inner-card > table { background-color: #151515 !important; }
      [data-ogsc] .inner-card td { background-color: #151515 !important; }
      [data-ogsc] .footer-bg { background-color: #111111 !important; }
      [data-ogsc] .footer-bg > table { background-color: #111111 !important; }
      [data-ogsc] .footer-bg td { background-color: #111111 !important; }
      [data-ogsc] .btn-appstore { background-color: #CDFF50 !important; }
      [data-ogsc] .btn-appstore a { color: #0B0B0B !important; background-color: #CDFF50 !important; }
      [data-ogsc] .btn-gplay { background-color: #2A2A2A !important; }
      [data-ogsc] .btn-gplay a { color: #FFFFFF !important; background-color: #2A2A2A !important; }
      u + .body .btn-appstore { background-color: #CDFF50 !important; }
      u + .body .btn-appstore a { color: #0B0B0B !important; background-color: #CDFF50 !important; }
      u + .body .btn-gplay { background-color: #2A2A2A !important; }
      u + .body .btn-gplay a { color: #FFFFFF !important; background-color: #2A2A2A !important; }
      [data-ogsc] .sig-text, [data-ogsc] .sig-text div { color: #9A9A9A !important; }
      [data-ogsc] .sig-ps { color: #777777 !important; }
      [data-ogsc] .footer-text, [data-ogsc] .footer-text div { color: #666666 !important; }
      [data-ogsc] a.footer-link { color: #666666 !important; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#0F0F0F" width="560px" css-class="bg-grad">

    <!-- Top spacer -->
    <mj-section padding="32px 0 0"><mj-column><mj-text padding="0"> </mj-text></mj-column></mj-section>

    <!-- MAIN VISUAL: hero + cards + premium — desktop (560px) -->
    <mj-section padding="0" background-color="#151515" css-class="inner-card desktop-only">
      <mj-column padding="0">
        <mj-image src="img/full-email.png"
          alt="We rebuilt Helthy. Here's what's new. v2 is live on iOS and Android. AI got smarter, deeper insights, faster logging, Android launch, and Premium at $2.99/mo."
          width="560px" height="1442px" padding="0" />
      </mj-column>
    </mj-section>
    <!-- MAIN VISUAL: hero + cards + premium — mobile (375px) -->
    <mj-section padding="0" css-class="mobile-only">
      <mj-column padding="0">
        <mj-image src="img/full-email-mobile.png"
          alt="We rebuilt Helthy. Here's what's new. v2 is live on iOS and Android. AI got smarter, deeper insights, faster logging, Android launch, and Premium at $2.99/mo."
          width="375px" height="1413px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- SIG + FOOTER — desktop (560px) -->
    <mj-section padding="0" css-class="desktop-only">
      <mj-column padding="0">
        <mj-image src="img/sig-footer.png"
          alt="Already have it? Update the app to get v2. – Chibu &amp; Ebuka. P.S. Reply directly with feedback — we read every message."
          width="560px" height="303px" padding="0" />
      </mj-column>
    </mj-section>
    <!-- SIG + FOOTER — mobile (375px) -->
    <mj-section padding="0" css-class="mobile-only">
      <mj-column padding="0">
        <mj-image src="img/sig-footer-mobile.png"
          alt="Already have it? Update the app to get v2. – Chibu &amp; Ebuka. P.S. Reply directly with feedback — we read every message."
          width="375px" height="280px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Real store button links — no background cell -->
    <mj-section padding="0">
      <mj-column padding="0">
        <mj-raw>
          <table cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin:0 auto;">
            <tr>
              <td style="padding-right:12px;vertical-align:middle;">
                <a href="https://apps.apple.com/us/app/helthy-track-food-workouts/id6751759974" style="display:block;text-decoration:none;">
                  <img src="img/btn-appstore.png" alt="Download on the App Store" width="141" height="45" style="display:block;border:0;" />
                </a>
              </td>
              <td style="vertical-align:middle;">
                <a href="https://play.google.com/store/apps/details?id=com.helthy.app" style="display:block;text-decoration:none;">
                  <img src="img/btn-googleplay.png" alt="Get it on Google Play" width="157" height="47" style="display:block;border:0;" />
                </a>
              </td>
            </tr>
          </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <!-- Compliance -->
    <mj-section padding="16px 40px 0">
      <mj-column padding="0">
        <mj-text align="center" font-size="11px" color="#555555" padding="0">
          <a href="{unsubscribe_link}" style="color:#555555;text-decoration:underline;">Unsubscribe</a>
          &nbsp;&middot;&nbsp;
          <a href="https://helthy.app/privacy" style="color:#555555;text-decoration:underline;">Privacy Policy</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Bottom spacer -->
    <mj-section padding="40px 0 0"><mj-column><mj-text padding="0"> </mj-text></mj-column></mj-section>

  </mj-body>
</mjml>
